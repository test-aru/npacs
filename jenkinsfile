pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                // Use Maven to build and package your project
                maven 'mvn clean package'
            }
        }
        stage('Test') {
            steps {
                // Run Selenium tests using Maven
                maven 'mvn test'
                // Publish test results
                junit '**/TEST-*.xml'
            }
        }
    }
}
