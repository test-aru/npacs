pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                // Checkout the latest code from the repository
                git 'https://github.com/test-aru/npacs.git'
            }
        }
        stage('Build') {
            steps {
                // Compile and package the project using Maven
                sh 'mvn clean package'
            }
        }
        stage('Test') {
            steps {
                // Run tests using Maven
                sh 'mvn test'
            }
            post {
                always {
                    // Publish JUnit test results
                    junit '**/target/surefire-reports/TEST-*.xml'
                }
            }
        }
        stage('Selenium Tests') {
            steps {
                // Execute Selenium tests with TestNG
                sh 'mvn test -Dtest=YourSeleniumTestClass'
            }
            post {
                always {
                    // Publish Selenium test results
                    junit '**/target/surefire-reports/TEST-*.xml'
                }
            }
        }
    }
    post {
        always {
            // Clean up workspace or perform other post-build actions
            cleanWs()
        }
    }
}
